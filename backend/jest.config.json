{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testMatch": ["<rootDir>/src/**/*.spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "haste": {
    "enableSymlinks": true,
    "forceNodeFilesystemAPI": true
  },
  "watchman": false,
  "testEnvironment": "node"
}
